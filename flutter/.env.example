SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# OAuth web client ID for Google Calendar and Google Tasks API access.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# OAuth redirect origin for production Supabase login.
# Use your Firebase Hosting or custom domain, for example:
# AUTH_REDIRECT_ORIGIN=https://your-app.web.app
AUTH_REDIRECT_ORIGIN=

# Public FastAPI worker URL for Agent chat. This is not a secret.
FASTAPI_BASE_URL=http://localhost:8000

# MCP Gateway URL for AI platform integrations (Claude, Cursor, OpenAI).
# Mounted at /mcp on the FastAPI worker.
MCP_SERVER_URL=http://localhost:8000/mcp

# Do not put AI API keys, Supabase service role, QStash, worker, or FCM
# secrets here.
# Flutter bundles this file as an app asset. Use server.env.example for secrets.
